# Xcode
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Swift Package Manager
.build/
# Ignore resolved/cached SPM checkouts (Packages/) without swallowing our
# own local packages — those are part of the source tree.
Packages/*
!Packages/FileFlussCore
Package.resolved

# macOS
.DS_Store
*.swp
*~

# LLVM code coverage artifacts
*.profraw

# Xcode project (generated by XcodeGen)
*.xcodeproj

# Secrets
FileFluss/Resources/Secrets.xcconfig
