/* FileFlussCore — package-owned, user-facing strings (cloud error messages). */
"Not authenticated. Please sign in." = "未认证。请登录。";
"This feature is not yet implemented." = "此功能尚未实现。";
"Network error: %@" = "网络错误：%@";
"Authorization expired. Please sign in again." = "授权已过期。请重新登录。";
"Two-factor authentication required. Enter your 6-digit code and try again." = "需要双重认证。请输入你的 6 位验证码后重试。";
"Item not found: %@" = "未找到项目：%@";
"Storage quota exceeded." = "已超出存储配额。";
"Rate limited. Please try again later." = "请求过于频繁。请稍后重试。";
"Server error (HTTP %d)." = "服务器错误（HTTP %d）。";
"Invalid response from server." = "服务器返回了无效响应。";
"Invalid email or password." = "电子邮件或密码无效。";
"File is too large to upload (%@). This provider's limit is %@." = "文件过大，无法上传（%@）。此服务商的上限为 %@。";
"File is too large to upload (%@). The provider rejected it. Try splitting the file or using a different cloud." = "文件过大，无法上传（%@）。服务商已拒绝。请尝试拆分文件或改用其他云服务。";

/* MEGA download that fails its integrity check */
"The downloaded file is corrupted: its MEGA integrity check (MAC) does not match." = "下载的文件已损坏：其 MEGA 完整性校验（MAC）不匹配。";

/* SFTP host keys */
"Host key changed" = "主机密钥已更改";
"Host key verification failed — the server's host key changed. If you expected this, edit the account and connect again to accept the new key." = "主机密钥验证失败——服务器的主机密钥已更改。如果这在你的预料之中，请编辑账户并重新连接以接受新密钥。";
"The SSH host key of %@ has changed since you last connected. This happens when the server was reinstalled — or when someone intercepts the connection.\n\nPreviously: %@\nNow: %@\n\nTrust the new key?" = "自上次连接以来，%@ 的 SSH 主机密钥已更改。服务器重新安装后会出现这种情况——也可能是有人在拦截连接。\n\n之前：%@\n现在：%@\n\n要信任新密钥吗？";
"Trust this server?" = "要信任此服务器吗？";
"This is the first connection to %@. Check that this SSH host key fingerprint is the server's — your provider or administrator can confirm it:\n\n%@\n\nTrust this key and connect?" = "这是首次连接到 %@。请确认此 SSH 主机密钥指纹属于该服务器——你的服务商或管理员可以帮你核实：\n\n%@\n\n要信任此密钥并连接吗？";
"SFTP can't work with a name that contains a line break." = "SFTP 无法处理包含换行符的名称。";
"The server's host key wasn't trusted, so FileFluss didn't connect." = "未信任服务器的主机密钥，因此 FileFluss 没有连接。";
