/* FileFlussCore — package-owned, user-facing strings (cloud error messages). */
"Not authenticated. Please sign in." = "未驗證。請登入。";
"This feature is not yet implemented." = "此功能尚未實作。";
"Network error: %@" = "網路錯誤：%@";
"Authorization expired. Please sign in again." = "授權已過期。請重新登入。";
"Two-factor authentication required. Enter your 6-digit code and try again." = "需要雙重驗證。請輸入你的 6 位驗證碼後重試。";
"Item not found: %@" = "找不到項目：%@";
"Storage quota exceeded." = "已超出儲存配額。";
"Rate limited. Please try again later." = "請求過於頻繁。請稍後重試。";
"Server error (HTTP %d)." = "伺服器錯誤（HTTP %d）。";
"Invalid response from server." = "伺服器回傳了無效的回應。";
"Invalid email or password." = "電子郵件或密碼無效。";
"File is too large to upload (%@). This provider's limit is %@." = "檔案過大，無法上傳（%@）。此服務商的上限為 %@。";
"File is too large to upload (%@). The provider rejected it. Try splitting the file or using a different cloud." = "檔案過大，無法上傳（%@）。服務商已拒絕。請嘗試拆分檔案或改用其他雲端服務。";
