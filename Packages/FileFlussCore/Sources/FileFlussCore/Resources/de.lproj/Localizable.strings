/* FileFlussCore — package-owned, user-facing strings (cloud error messages). */
"Not authenticated. Please sign in." = "Nicht angemeldet. Bitte melde dich an.";
"This feature is not yet implemented." = "Diese Funktion ist noch nicht verfügbar.";
"Network error: %@" = "Netzwerkfehler: %@";
"Authorization expired. Please sign in again." = "Autorisierung abgelaufen. Bitte melde dich erneut an.";
"Two-factor authentication required. Enter your 6-digit code and try again." = "Zwei-Faktor-Authentifizierung erforderlich. Gib deinen sechsstelligen Code ein und versuche es erneut.";
"Item not found: %@" = "Objekt nicht gefunden: %@";
"Storage quota exceeded." = "Speicherkontingent überschritten.";
"Rate limited. Please try again later." = "Anfragelimit erreicht. Bitte versuche es später erneut.";
"Server error (HTTP %d)." = "Serverfehler (HTTP %d).";
"Invalid response from server." = "Ungültige Antwort vom Server.";
"Invalid email or password." = "Ungültige E-Mail-Adresse oder ungültiges Passwort.";
"File is too large to upload (%@). This provider's limit is %@." = "Datei ist zu groß zum Hochladen (%@). Das Limit dieses Anbieters beträgt %@.";
"File is too large to upload (%@). The provider rejected it. Try splitting the file or using a different cloud." = "Datei ist zu groß zum Hochladen (%@). Der Anbieter hat sie abgelehnt. Teile die Datei auf oder verwende einen anderen Cloud-Dienst.";

/* MEGA download that fails its integrity check */
"The downloaded file is corrupted: its MEGA integrity check (MAC) does not match." = "Die heruntergeladene Datei ist beschädigt: Ihre MEGA-Integritätsprüfung (MAC) stimmt nicht überein.";

/* SFTP host keys */
"Host key changed" = "Hostschlüssel geändert";
"Host key verification failed — the server's host key changed. If you expected this, edit the account and connect again to accept the new key." = "Überprüfung des Hostschlüssels fehlgeschlagen – der Hostschlüssel des Servers hat sich geändert. Wenn du das erwartet hast, bearbeite das Konto und verbinde dich erneut, um den neuen Schlüssel zu akzeptieren.";
"The SSH host key of %@ has changed since you last connected. This happens when the server was reinstalled — or when someone intercepts the connection.\n\nPreviously: %@\nNow: %@\n\nTrust the new key?" = "Der SSH-Hostschlüssel von %@ hat sich seit deiner letzten Verbindung geändert. Das passiert, wenn der Server neu installiert wurde – oder wenn jemand die Verbindung abfängt.\n\nBisher: %@\nJetzt: %@\n\nDem neuen Schlüssel vertrauen?";
"Trust this server?" = "Diesem Server vertrauen?";
"This is the first connection to %@. Check that this SSH host key fingerprint is the server's — your provider or administrator can confirm it:\n\n%@\n\nTrust this key and connect?" = "Das ist die erste Verbindung zu %@. Prüfe, ob dieser Fingerabdruck des SSH-Hostschlüssels zum Server gehört – dein Anbieter oder Administrator kann ihn bestätigen:\n\n%@\n\nDiesem Schlüssel vertrauen und verbinden?";
"SFTP can't work with a name that contains a line break." = "SFTP kann mit einem Namen, der einen Zeilenumbruch enthält, nicht arbeiten.";
"The server's host key wasn't trusted, so FileFluss didn't connect." = "Dem Hostschlüssel des Servers wurde nicht vertraut, daher hat FileFluss keine Verbindung hergestellt.";
