/* FileFlussCore — package-owned, user-facing strings (cloud error messages). */
"Not authenticated. Please sign in." = "Not authenticated. Please sign in.";
"This feature is not yet implemented." = "This feature is not yet implemented.";
"Network error: %@" = "Network error: %@";
"Authorization expired. Please sign in again." = "Authorization expired. Please sign in again.";
"Two-factor authentication required. Enter your 6-digit code and try again." = "Two-factor authentication required. Enter your 6-digit code and try again.";
"Item not found: %@" = "Item not found: %@";
"Storage quota exceeded." = "Storage quota exceeded.";
"Rate limited. Please try again later." = "Rate limited. Please try again later.";
"Server error (HTTP %d)." = "Server error (HTTP %d).";
"Invalid response from server." = "Invalid response from server.";
"Invalid email or password." = "Invalid email or password.";
