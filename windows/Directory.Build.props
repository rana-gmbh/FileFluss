<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!--
      MSB3568 is GenerateResource reporting that two resource names folded together and it
      dropped one: a string silently missing from every language while the build stays green.
      Same rule as the NetFluss Windows port, where it already bit once.
    -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB3568</MSBuildWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;de;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <Company>Rana GmbH</Company>
    <Product>FileFluss</Product>
    <Copyright>Copyright © 2026 Rana GmbH</Copyright>
    <Version>0.1.0</Version>
    <!-- Matches the macOS app's GPLv3 licensing. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
