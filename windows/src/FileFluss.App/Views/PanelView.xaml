<UserControl x:Class="FileFluss.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:FileFluss.App.Services"
             xmlns:vm="clr-namespace:FileFluss.App.ViewModels"
             AllowDrop="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <!-- Active panel marker: a thin accent line, as on macOS. -->
        <Border x:Name="ActiveLine" DockPanel.Dock="Top" Height="2" Background="{DynamicResource ActivePanelBrush}" Opacity="0" />

        <!-- Path bar -->
        <Grid DockPanel.Dock="Top" Margin="6,4,6,2" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CrumbButton}" Click="OnCrumbClick" Tag="{Binding}"
                                        DragEnter="OnCrumbDragOver" DragOver="OnCrumbDragOver" DragLeave="OnCrumbDragLeave" Drop="OnCrumbDrop">
                                    <TextBlock x:Name="Text" Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"
                                           Margin="1,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBox x:Name="PathEditor" Visibility="Collapsed" VerticalContentAlignment="Center"
                     KeyDown="OnPathEditorKeyDown" LostKeyboardFocus="OnPathEditorLostFocus" />
            <ProgressBar Grid.Column="1" Width="60" Height="3" Margin="6,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- Quick filter -->
        <Grid DockPanel.Dock="Top" Margin="8,2,8,4" Visibility="{Binding IsFilterVisible, Converter={StaticResource Visible}}">
            <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnFilterKeyDown"
                     ToolTip="{u:Loc 'Filter visible items…'}" />
        </Grid>

        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="10,3,10,5" x:Name="StatusBar">
            <TextBlock DockPanel.Dock="Right" Text="{Binding QuotaText}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </DockPanel>

        <Grid>
            <ListView x:Name="List"
                      ItemsSource="{Binding Rows}"
                      ItemContainerStyle="{StaticResource FileRowStyle}"
                      SelectionMode="Extended"
                      BorderThickness="0"
                      Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Name"
                      AllowDrop="True"
                      KeyboardNavigation.TabNavigation="None"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnDoubleClick"
                      PreviewMouseLeftButtonDown="OnListMouseDown"
                      PreviewMouseMove="OnListMouseMove"
                      PreviewMouseRightButtonDown="OnListRightButtonDown"
                      ContextMenuOpening="OnContextMenuOpening"
                      GotKeyboardFocus="OnListFocused"
                      DragEnter="OnListDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                <ListView.ContextMenu>
                    <ContextMenu x:Name="RowMenu" />
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView x:Name="Grid" ColumnHeaderContainerStyle="{StaticResource FileHeaderStyle}" AllowsColumnReorder="True">
                        <GridViewColumn x:Name="NameColumn" Width="280">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Click="OnHeaderClick" Content="{u:Loc Name}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <Grid Opacity="{Binding Opacity}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="900">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="4,0,8,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="NameText" />
                                        <TextBox Grid.Column="1" x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                                 Padding="2,0" MinHeight="22" VerticalContentAlignment="Center" Margin="-3,0,0,0"
                                                 KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisible" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="DateColumn" Width="140">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Date" Click="OnHeaderClick" Content="{u:Loc 'Date Modified'}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeColumn" Width="90">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Click="OnHeaderClick" Content="{u:Loc Size}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="KindColumn" Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Kind" Click="OnHeaderClick" Content="{u:Loc Kind}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding KindText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Empty, error and re-authentication states -->
            <TextBlock Text="{u:Loc 'Empty Folder'}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" IsHitTestVisible="False" />
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Visibility="Collapsed">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="ReauthButton" Margin="0,14,0,0" HorizontalAlignment="Center" Content="{u:Loc 'Sign In Again'}"
                        Visibility="{Binding NeedsReauthentication, Converter={StaticResource Visible}}" Click="OnReauthenticate" />
                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="{u:Loc Retry}" Click="OnRetry" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
