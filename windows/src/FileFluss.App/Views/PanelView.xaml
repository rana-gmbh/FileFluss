<UserControl x:Class="FileFluss.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:FileFluss.App.Services"
             xmlns:vm="clr-namespace:FileFluss.App.ViewModels"
             xmlns:local="clr-namespace:FileFluss.App.Views"
             AllowDrop="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <!-- Active panel marker: a thin accent line, as on macOS. -->
        <Border x:Name="ActiveLine" DockPanel.Dock="Top" Height="2" Background="{DynamicResource ActivePanelBrush}" Opacity="0" />

        <!-- Path bar -->
        <Grid DockPanel.Dock="Top" Margin="6,4,6,2" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CrumbButton}" Click="OnCrumbClick" Tag="{Binding}"
                                        DragEnter="OnCrumbDragOver" DragOver="OnCrumbDragOver" DragLeave="OnCrumbDragLeave" Drop="OnCrumbDrop">
                                    <TextBlock x:Name="Text" Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"
                                           Margin="1,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBox x:Name="PathEditor" Visibility="Collapsed" VerticalContentAlignment="Center"
                     KeyDown="OnPathEditorKeyDown" LostKeyboardFocus="OnPathEditorLostFocus" />
            <ProgressBar Grid.Column="1" Width="60" Height="3" Margin="6,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />

            <!-- List / gallery switch (macOS: at the right end of each panel's path bar). It belongs
                 to its panel, so it is obvious which side it changes. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0"
                        ToolTip="{u:Loc 'Show this panel as a list or as a gallery'}">
                <ToggleButton x:Name="ListModeButton" Style="{StaticResource GlyphButton}" Width="28" Height="26" FontSize="13" IsTabStop="False"
                              Content="{x:Static u:Glyphs.List}" Click="OnListModeClick" AutomationProperties.Name="{u:Loc List}" />
                <ToggleButton x:Name="GalleryModeButton" Style="{StaticResource GlyphButton}" Width="28" Height="26" FontSize="13" IsTabStop="False"
                              Content="{x:Static u:Glyphs.Gallery}" Click="OnGalleryModeClick" AutomationProperties.Name="{u:Loc Gallery}" />
            </StackPanel>
        </Grid>

        <!-- Offline view: an offline account or unplugged drive, browsed from the index -->
        <Border DockPanel.Dock="Top" Margin="8,2,8,4" Padding="10,5" CornerRadius="5" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsOffline, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static u:Glyphs.Offline}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding OfflineBanner}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding OfflineBanner}" />
            </StackPanel>
        </Border>

        <!-- Quick filter (macOS PanelFilterBar): placeholder, clear, close; Esc closes. -->
        <Grid DockPanel.Dock="Top" Margin="8,2,8,4" Visibility="{Binding IsFilterVisible, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static u:Glyphs.Filter}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="FilterBox" Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnFilterKeyDown"
                     Padding="6,2,28,2" VerticalContentAlignment="Center" AutomationProperties.Name="{u:Loc 'Filter visible items…'}" />
            <TextBlock Grid.Column="1" Text="{u:Loc 'Filter visible items…'}" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,3,0" Width="24" Height="24" FontSize="10"
                    Content="&#xE894;" Click="OnClearFilter" ToolTip="{u:Loc 'Clear filter'}" AutomationProperties.Name="{u:Loc 'Clear filter'}" IsTabStop="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource GlyphButton}" Width="28" Height="28" FontSize="11"
                    Content="{x:Static u:Glyphs.Cancel}" Click="OnCloseFilter" ToolTip="{u:Loc 'Close filter (Esc)'}" AutomationProperties.Name="{u:Loc 'Close filter (Esc)'}" />
        </Grid>

        <!-- Status bar: listing · selection · free space or quota (macOS statusFooter) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="10,3,10,5" x:Name="StatusBar">
            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Style="{StaticResource Caption}" />
        </DockPanel>

        <Grid>
            <ListView x:Name="List"
                      ItemsSource="{Binding Rows}"
                      ItemContainerStyle="{StaticResource FileRowStyle}"
                      SelectionMode="Extended"
                      BorderThickness="0"
                      Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Name"
                      AllowDrop="True"
                      KeyboardNavigation.TabNavigation="None"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnDoubleClick"
                      PreviewMouseLeftButtonDown="OnListMouseDown"
                      PreviewMouseMove="OnListMouseMove"
                      PreviewMouseRightButtonDown="OnListRightButtonDown"
                      ContextMenuOpening="OnContextMenuOpening"
                      GotKeyboardFocus="OnListFocused"
                      DragEnter="OnListDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                <ListView.ContextMenu>
                    <ContextMenu x:Name="RowMenu" />
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView x:Name="Grid" ColumnHeaderContainerStyle="{StaticResource FileHeaderStyle}" AllowsColumnReorder="True">
                        <GridView.ColumnHeaderContextMenu>
                            <ContextMenu x:Name="HeaderMenu" />
                        </GridView.ColumnHeaderContextMenu>
                        <GridViewColumn x:Name="NameColumn" Width="280">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Click="OnHeaderClick" Content="{u:Loc Name}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <Grid Opacity="{Binding Opacity}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="900">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="4,0,8,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="NameText" />
                                        <TextBox Grid.Column="1" x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                                 Padding="2,0" MinHeight="22" VerticalContentAlignment="Center" Margin="-3,0,0,0"
                                                 KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisible" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="DateColumn" Width="128">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Date" Click="OnHeaderClick" Content="{u:Loc 'Date Modified'}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="CreatedColumn" Width="128">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="DateCreated" Click="OnHeaderClick" Content="{u:Loc 'Date Created'}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding CreatedText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeColumn" Width="78">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Click="OnHeaderClick" Content="{u:Loc Size}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="KindColumn" Width="120">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Kind" Click="OnHeaderClick" Content="{u:Loc Kind}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                    <TextBlock Text="{Binding KindText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Gallery (macOS gallery view): the same rows as tiles, with the same handlers as the
                 list — selection, opening, the context menu, drag and drop and Quick Look all run
                 through the code the list uses. Only one of the two is visible. -->
            <ListBox x:Name="Gallery"
                     Visibility="Collapsed"
                     ItemsSource="{Binding Rows}"
                     ItemContainerStyle="{StaticResource GalleryTileStyle}"
                     SelectionMode="Extended"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     IsTextSearchEnabled="True"
                     TextSearch.TextPath="Name"
                     AllowDrop="True"
                     KeyboardNavigation.TabNavigation="None"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnDoubleClick"
                     PreviewMouseLeftButtonDown="OnListMouseDown"
                     PreviewMouseMove="OnListMouseMove"
                     PreviewMouseRightButtonDown="OnListRightButtonDown"
                     ContextMenuOpening="OnContextMenuOpening"
                     GotKeyboardFocus="OnListFocused"
                     DragEnter="OnListDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="GalleryMenu" />
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingTilePanel TileWidth="{DynamicResource GalleryTileWidth}" TileHeight="{DynamicResource GalleryTileHeight}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                        <Grid Opacity="{Binding Opacity}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="900" Margin="6,6,6,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Image Source="{Binding TileImage}" Width="{DynamicResource GalleryImageSize}" Height="{DynamicResource GalleryImageSize}"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- Two lines at most, as in Finder and Explorer; the full name is in the tooltip. -->
                            <TextBlock Grid.Row="1" x:Name="NameText" Text="{Binding DisplayName}" Margin="0,6,0,0" MaxHeight="34"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <TextBox Grid.Row="1" x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                     Margin="0,4,0,0" Padding="2,0" VerticalAlignment="Top" TextWrapping="Wrap" TextAlignment="Center"
                                     KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisible" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty, error and re-authentication states -->
            <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" IsHitTestVisible="False" />
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Visibility="Collapsed">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="ReauthButton" Margin="0,14,0,0" HorizontalAlignment="Center" Content="{u:Loc 'Sign In Again'}"
                        Visibility="{Binding NeedsReauthentication, Converter={StaticResource Visible}}" Click="OnReauthenticate" />
                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="{u:Loc Retry}" Click="OnRetry" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
