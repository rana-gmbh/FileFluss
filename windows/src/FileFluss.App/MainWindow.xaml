<Window x:Class="FileFluss.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileFluss" Height="700" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File"><MenuItem Header="New Folder" InputGestureText="Ctrl+Shift+N"/><Separator/><MenuItem Header="Exit"/></MenuItem>
            <MenuItem Header="_Edit"/><MenuItem Header="_View"/><MenuItem Header="_Go"/><MenuItem Header="_Help"/>
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Refresh"/><Button Content="Search"/><ToggleButton Content="Hidden Files"/><ToggleButton Content="Copy Mode"/>
        </ToolBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0">
                <ListBoxItem>Home</ListBoxItem><ListBoxItem>Desktop</ListBoxItem><ListBoxItem>Documents</ListBoxItem>
            </ListBox>
            <DataGrid x:Name="LeftGrid" Grid.Column="1" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"/>
            <ListView x:Name="RightList" Grid.Column="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80"/>
                        <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
