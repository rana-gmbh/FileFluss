<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only tests of the shell interop in FileFluss.Native, driven through real COM:
    apartments, proxies, the OLE clipboard and the Shell's own drop target. Pure logic is
    tested in FileFluss.Core.Tests, which runs on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      xunit.v3 runs through VSTest (xunit.runner.visualstudio) here, so `dotnet test` and the CI's
      trx logger work as before; on the .NET 10 SDK, Microsoft.Testing.Platform mode would need
      the new dotnet test experience and different command-line options.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!--
      xUnit1051 (xunit.v3) asks every call that takes a CancellationToken to pass
      TestContext.Current.CancellationToken. These tests are short and bounded by their own
      timeouts; threading the token through hundreds of call sites adds noise, not safety.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FileFluss.Native/FileFluss.Native.csproj" />
    <Compile Include="../FileFluss.Core.Tests/Support/MemoryCloudProvider.cs" Link="Support/MemoryCloudProvider.cs" />
  </ItemGroup>

</Project>
