   --------------------------------------------------------------------------------------------- */

"The request timed out." = "Zeitüberschreitung bei der Anfrage.";
"Could not connect to the server." = "Es konnte keine Verbindung zum Server hergestellt werden.";
"Network is unreachable from this PC." = "Das Netzwerk ist von diesem PC aus nicht erreichbar.";
"Permission denied." = "Zugriff verweigert.";
"Permission denied: %@" = "Zugriff verweigert: %@";
"Invalid file name." = "Ungültiger Dateiname.";
"TLS/SSL error: %@" = "TLS/SSL-Fehler: %@";
"the server's certificate could not be verified." = "das Zertifikat des Servers konnte nicht überprüft werden.";
"S3 error (HTTP %@): %@" = "S3-Fehler (HTTP %@): %@";
"S3 endpoint URL is invalid (host: \"%@\"). Double-check the Endpoint URL field." = "Die S3-Endpunkt-URL ist ungültig (Host: „%@“). Prüfe das Feld „Endpunkt-URL“.";
"This key isn't allowed to list the account's buckets (s3:ListAllMyBuckets). Enter the bucket name in the Path field — FileFluss then works with that bucket alone and won't ask for account-wide permissions." = "Dieser Schlüssel darf die Buckets des Kontos nicht auflisten (s3:ListAllMyBuckets). Gib den Bucket-Namen im Feld „Pfad“ ein – FileFluss arbeitet dann nur mit diesem Bucket und benötigt keine kontoweiten Berechtigungen.";
"The downloaded file is corrupted: its MEGA integrity check (MAC) does not match." = "Die heruntergeladene Datei ist beschädigt: Ihre MEGA-Integritätsprüfung (MAC) stimmt nicht überein.";

/* FTP and SFTP */
"FTP command failed." = "FTP-Befehl fehlgeschlagen.";
"Could not connect — check the host, port, and that FTP is reachable." = "Verbindung fehlgeschlagen – prüfe Host und Port und ob FTP erreichbar ist.";
"Could not resolve host. Check the server address." = "Host konnte nicht aufgelöst werden. Prüfe die Serveradresse.";
"Connection timed out." = "Zeitüberschreitung der Verbindung.";
"SFTP command failed." = "SFTP-Befehl fehlgeschlagen.";
"Connection refused — is the SSH daemon running on this host and port?" = "Verbindung abgelehnt – läuft der SSH-Dienst auf diesem Host und Port?";
"Connection timed out. Check the hostname, port, and your network." = "Zeitüberschreitung der Verbindung. Prüfe Hostname, Port und dein Netzwerk.";
"Could not resolve hostname. Check spelling or DNS." = "Hostname konnte nicht aufgelöst werden. Prüfe die Schreibweise oder das DNS.";
"SSH authentication failed. Check the username and password." = "SSH-Authentifizierung fehlgeschlagen. Prüfe Benutzername und Passwort.";
"SSH authentication failed. The server may not have your public key authorized, or the passphrase is wrong." = "SSH-Authentifizierung fehlgeschlagen. Möglicherweise ist dein öffentlicher Schlüssel auf dem Server nicht autorisiert, oder die Passphrase ist falsch.";
"SSH key was rejected by the server. Make sure the public key is in the server's ~/.ssh/authorized_keys (or added to the provider's SSH-keys panel for managed services like Hetzner Storage Box)." = "Der SSH-Schlüssel wurde vom Server abgelehnt. Stelle sicher, dass der öffentliche Schlüssel in ~/.ssh/authorized_keys auf dem Server steht (oder bei verwalteten Diensten wie der Hetzner Storage Box in der SSH-Schlüssel-Verwaltung des Anbieters hinterlegt ist).";
"The private key is protected by a passphrase. Enter it and try again." = "Der private Schlüssel ist durch eine Passphrase geschützt. Gib sie ein und versuche es erneut.";
"Wrong passphrase for the private key." = "Falsche Passphrase für den privaten Schlüssel.";
"Private key is in an unsupported format. Convert it to OpenSSH format (e.g. with `puttygen key.ppk -O private-openssh -o id_rsa`)." = "Der private Schlüssel liegt in einem nicht unterstützten Format vor. Konvertiere ihn ins OpenSSH-Format (z. B. mit `puttygen key.ppk -O private-openssh -o id_rsa`).";
"This SFTP operation is not supported by the bundled SSH library." = "Dieser SFTP-Vorgang wird von der mitgelieferten SSH-Bibliothek nicht unterstützt.";
"Host key changed" = "Hostschlüssel geändert";
"Host key verification failed — the server's host key changed. If you expected this, edit the account and connect again to accept the new key." = "Überprüfung des Hostschlüssels fehlgeschlagen – der Hostschlüssel des Servers hat sich geändert. Wenn du das erwartet hast, bearbeite das Konto und verbinde dich erneut, um den neuen Schlüssel zu akzeptieren.";
"The SSH host key of %@ has changed since you last connected. This happens when the server was reinstalled — or when someone intercepts the connection.\n\nPreviously: %@\nNow: %@\n\nTrust the new key?" = "Der SSH-Hostschlüssel von %@ hat sich seit deiner letzten Verbindung geändert. Das passiert, wenn der Server neu installiert wurde – oder wenn jemand die Verbindung abfängt.\n\nBisher: %@\nJetzt: %@\n\nDem neuen Schlüssel vertrauen?";

/* Seafile */
"Cannot delete a Seafile library from FileFluss. Use the Seafile web UI." = "Eine Seafile-Bibliothek kann nicht in FileFluss gelöscht werden. Verwende die Seafile-Weboberfläche.";
"Cannot share the Seafile library list — pick a file or folder inside a library." = "Die Liste der Seafile-Bibliotheken kann nicht geteilt werden – wähle eine Datei oder einen Ordner innerhalb einer Bibliothek.";
"Cannot upload directly to the Seafile library root — pick a library first." = "In die oberste Ebene der Seafile-Bibliotheken kann nicht direkt hochgeladen werden – wähle zuerst eine Bibliothek.";
"Create a library in the Seafile web UI before adding folders." = "Erstelle in der Seafile-Weboberfläche eine Bibliothek, bevor du Ordner hinzufügst.";
"Rename a Seafile library from its web UI." = "Benenne eine Seafile-Bibliothek in der Weboberfläche um.";
"This library is encrypted. Unlock it in the Seafile web interface, then try again." = "Diese Bibliothek ist verschlüsselt. Entsperre sie in der Seafile-Weboberfläche und versuche es dann erneut.";

