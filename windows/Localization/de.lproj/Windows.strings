"Filen API error" = "Filen-API-Fehler";
"Filen /v3/auth/info returned an unexpected payload." = "Filen /v3/auth/info hat unerwartete Daten geliefert.";
"Filen /v3/user/baseFolder didn't return a root UUID." = "Filen /v3/user/baseFolder hat keine Stamm-UUID geliefert.";
