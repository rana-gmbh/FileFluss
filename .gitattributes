# Line endings and binary classification.
#
# FileFluss is authored on macOS but the Windows port is developed on Windows, so the
# repository is now written from two platforms. Without this file, git on Windows
# defaults to core.autocrlf=true and rewrites the line endings of every file it
# touches, producing commits full of whole-file diffs.
#
# Policy: normalise everything to LF in the repository and check out LF everywhere.
# Only the handful of formats that genuinely want CRLF on Windows are excepted.

* text=auto eol=lf

# ---------------------------------------------------------------------------
# Formats that must stay CRLF on Windows
# ---------------------------------------------------------------------------

# Visual Studio rewrites solution files with CRLF on every save; leaving them LF
# guarantees a spurious diff the first time anyone opens FileFluss.sln.
*.sln       text eol=crlf

# Batch files are parsed line-by-line by cmd.exe and misbehave with bare LF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------------------------------------------------------------------------
# Formats that must stay LF
# ---------------------------------------------------------------------------

# A shell script with CRLF fails as "bad interpreter: /bin/bash^M".
*.sh        text eol=lf

*.swift     text eol=lf
*.cs        text eol=lf
*.py        text eol=lf
*.strings   text eol=lf

# ---------------------------------------------------------------------------
# Binary — never diffed, never line-ending converted
#
# Screenshots, logos and icons are tracked; marking them keeps text=auto heuristics out of it.
# ---------------------------------------------------------------------------

*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.icns      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.mov       binary
*.mp4       binary
*.dylib     binary
*.so        binary
*.dll       binary
*.exe       binary
*.msi       binary
*.nupkg     binary

# ---------------------------------------------------------------------------
# GitHub presentation
# ---------------------------------------------------------------------------

# Generated from the macOS Localizable.strings by windows/tools/StringsToResx.
# Collapsing them keeps a translation change from burying the real diff, and keeps
# 200 KB of generated XML out of the repository's language statistics.
windows/src/FileFluss.Core/Resources/*.resx          linguist-generated=true
windows/src/FileFluss.Core/Resources/platform-review.md linguist-generated=true

